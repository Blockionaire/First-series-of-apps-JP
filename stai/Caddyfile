{
	email {$ACME_EMAIL}
	# Caddy obtains and renews Let's Encrypt certificates automatically.
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Proxy by Docker service name over the private network. The app is not
	# reachable from the internet by any other path.
	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	# HSTS is also set by the app; Caddy asserts it for every response
	# including its own error pages. Caddy adds TLS — the app-level CSP and
	# other security headers pass through untouched.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Bare www → apex, so one canonical origin serves everything.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
