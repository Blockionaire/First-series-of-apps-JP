# ─────────────────────────────────────────────────────────────
# STAI environment. Copy to .env (compose reads it automatically).
# NEVER commit a filled-in copy — .gitignore excludes .env*, with an
# explicit exception for this example file.
# ─────────────────────────────────────────────────────────────

# ══ REQUIRED FOR STARTUP (docker compose refuses to start without these) ══

# Public origin, no trailing slash. Used for Stripe redirect URLs.
# Mandatory in production: redirect targets are NEVER derived from the
# request Origin header, because that header is attacker-controlled.
APP_URL=https://stai.ai

# The hostname Caddy serves and obtains a TLS certificate for.
SITE_DOMAIN=stai.ai
ACME_EMAIL=ops@stai.ai

# Content-desk admin. Without BOTH, no admin account is created at all —
# there is deliberately no default password. Minimum 12 characters.
STAI_ADMIN_EMAIL=
STAI_ADMIN_PASSWORD=

# ══ REQUIRED FOR SECURE PRODUCTION ══

# Without a Stripe key, checkout is UNAVAILABLE in production. It never
# falls back to the development sandbox — that path is compiled out of
# reach when NODE_ENV=production.
STRIPE_SECRET_KEY=
# From the Stripe dashboard for the endpoint https://<APP_URL>/api/stripe/webhook
# Subscribe that endpoint to at least:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   customer.subscription.paused, customer.subscription.resumed,
#   invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Set by the Dockerfile; only override in development.
# STAI_DATA_DIR=/data

# ══ OPTIONAL FEATURES (each degrades honestly when absent) ══

# Absent: Ask STAI serves cited passages in retrieval-only mode and
# adapt-with-AI performs a deterministic context merge. Both labelled in UI.
ANTHROPIC_API_KEY=
# Platform-wide monthly model-call ceiling; on breach Ask STAI degrades
# to retrieval-only rather than billing onward.
ASK_MONTHLY_CALL_CEILING=5000

# Absent: mail queues durably in the outbox, visible at /admin.
# Configure SPF, DKIM and DMARC on the sending domain BEFORE the first send.
RESEND_API_KEY=
MAIL_FROM="STAI <brief@stai.ai>"
TRAINING_INBOX=training@stai.ai
FIRMS_INBOX=

# Founding-member offer size. The claimed counter always starts at 0 and
# moves only on real subscriptions — never pre-seed it.
STAI_FOUNDING_TOTAL=200

# ══ BACKUPS (see litestream.yml) ══
BACKUP_KEEP=168
# BACKUP_DIR=/data/backups
# LITESTREAM_S3_ENDPOINT=
# LITESTREAM_S3_BUCKET=
# LITESTREAM_S3_REGION=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
