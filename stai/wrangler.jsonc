{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stai",

  // NOT .open-next/worker.js directly. A Durable Object class must be exported
  // from the deployed script, and that file is regenerated by every OpenNext
  // build. worker/entry.ts re-exports it verbatim and adds RateLimiterDO.
  "main": "worker/entry.ts",

  // Current date. Recent compatibility dates enable Node.js compatibility
  // behaviour by default, so no legacy flags are set here — nodejs_compat is
  // the one thing OpenNext genuinely requires, and it is requested explicitly
  // rather than inherited, because the whole Next server runtime depends on it.
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Newsroom discovery.
  //
  // Every thirty minutes is the TRIGGER rate, not the fetch rate. Each run
  // asks every registered source whether its own cadence has elapsed — Tier 1
  // every 30 minutes, Tier 2 hourly, Tier 3 every two hours — so most firings
  // skip most sources and log why. That is the intent: one schedule here,
  // per-source politeness enforced in the code that knows the source.
  //
  // The handler calls the discovery service directly — it makes no HTTP
  // request to the application's own routes, so there is no public endpoint
  // that starts a crawl and no shared secret to manage. Whether it does
  // anything is a site setting ("Newsroom discovery (scheduled)"), which ships
  // OFF: this trigger can be live for weeks while discovery is switched off.
  // See DISCOVERY.md.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stai-production",
      // The production database, created in the Cloudflare dashboard.
      // A database id is not a secret: it names a resource, it does not
      // grant access to one. `wrangler dev --local` ignores it entirely and
      // uses a SQLite file under .wrangler/state.
      "database_id": "75654fb3-9c33-40fa-bb84-46f8cbcf076a",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        // The global rate-limit counter. See worker/rate-limiter-do.ts for why
        // this is a Durable Object rather than Cloudflare's native Rate
        // Limiting binding: the native one cannot express "5 per hour".
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      }
    ]
  },

  // SQLite-backed storage, which is the current recommended backend for new
  // Durable Object classes. `new_sqlite_classes` is what selects it, and it can
  // only be chosen at class creation — a class created with the older key-value
  // backend cannot be converted later, so it matters that this is right the
  // first time and before any remote deploy exists.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ],

  "vars": {
    // How the application knows which database driver to install.
    //
    // NEXT_RUNTIME cannot answer this: OpenNext runs Next's *node* runtime on
    // Workers, so NEXT_RUNTIME === "nodejs" in both places. Branching on it
    // would make a Worker try to load better-sqlite3 — a native addon Workers
    // cannot load — and the failure would look like a database outage rather
    // than a misconfiguration.
    "STAI_RUNTIME": "workers",

    // The public origin. Canonical URLs, OG image URLs and every sitemap entry
    // are built from this by src/lib/seo.ts.
    //
    // The name matters. The application reads APP_URL (src/lib/config.ts); an
    // earlier version of this file set NEXT_PUBLIC_APP_URL, which nothing
    // reads. The effect was not an error but something quieter and worse:
    // publicUrl() fell through to its "https://stai.ai" default, so a
    // production deploy would have served correct pages advertising canonical
    // URLs on a domain this deployment does not own.
    //
    // Set to the production domain rather than the workers.dev URL on purpose.
    // The workers.dev hostname is a staging detail and must never appear in a
    // canonical tag or a sitemap where a crawler can index it. During the
    // workers.dev smoke test the pages therefore name stai-ahead.com in their
    // metadata while being served from workers.dev — correct, and the reason
    // the smoke script requests relative paths rather than following
    // canonicals.
    //
    // Local `wrangler dev` overrides this in .dev.vars.
    // Payments are frozen for the free launch. STRIPE_SECRET_KEY is
    // deliberately absent, not empty-stringed, so nothing can mistake an
    // unset key for a configured one. NODE_ENV is left to Next, which sets it
    // to "production" in a built Worker; overriding it here would change
    // paywall and sandbox behaviour as a side effect.
    "APP_URL": "https://stai-ahead.com"
  }
}
