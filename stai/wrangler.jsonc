{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stai",

  // NOT .open-next/worker.js directly. A Durable Object class must be exported
  // from the deployed script, and that file is regenerated by every OpenNext
  // build. worker/entry.ts re-exports it verbatim and adds RateLimiterDO.
  "main": "worker/entry.ts",

  // Current date. Recent compatibility dates enable Node.js compatibility
  // behaviour by default, so no legacy flags are set here — nodejs_compat is
  // the one thing OpenNext genuinely requires, and it is requested explicitly
  // rather than inherited, because the whole Next server runtime depends on it.
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stai",
      // PLACEHOLDER. No production database exists yet and no Cloudflare
      // account has been contacted. `wrangler dev` ignores this id entirely and
      // uses a local SQLite file under .wrangler/state; the real id is filled
      // in at deploy time, which is a later phase.
      "database_id": "local-development-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        // The global rate-limit counter. See worker/rate-limiter-do.ts for why
        // this is a Durable Object rather than Cloudflare's native Rate
        // Limiting binding: the native one cannot express "5 per hour".
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      }
    ]
  },

  // SQLite-backed storage, which is the current recommended backend for new
  // Durable Object classes. `new_sqlite_classes` is what selects it, and it can
  // only be chosen at class creation — a class created with the older key-value
  // backend cannot be converted later, so it matters that this is right the
  // first time and before any remote deploy exists.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ],

  "vars": {
    // How the application knows which database driver to install.
    //
    // NEXT_RUNTIME cannot answer this: OpenNext runs Next's *node* runtime on
    // Workers, so NEXT_RUNTIME === "nodejs" in both places. Branching on it
    // would make a Worker try to load better-sqlite3 — a native addon Workers
    // cannot load — and the failure would look like a database outage rather
    // than a misconfiguration.
    "STAI_RUNTIME": "workers",

    // Payments are frozen for the free launch. STRIPE_SECRET_KEY is
    // deliberately absent, not empty-stringed, so nothing can mistake an
    // unset key for a configured one.
    "NEXT_PUBLIC_APP_URL": "http://localhost:8787"
  }
}
