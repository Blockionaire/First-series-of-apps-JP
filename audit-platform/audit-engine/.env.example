# Copy to .env.local (gitignored) at the API gate — see ../08 §G.
# The source of truth for this key is your password manager. This file is a working copy
# that exists only on your machine; it is never committed and never pasted into a shell
# profile, where it would sit in plaintext for every process you run.
#
#   cp .env.example .env.local     # then paste the key
#   node --env-file-if-exists=.env.local apps/cli/src/index.ts run corpus/synthetic/case-01
#
# Stronger option, where the key never touches disk at all — inject it from the password
# manager for the life of one command:
#
#   op run --env-file=.env.tpl -- node apps/cli/src/index.ts run ...   # 1Password
#   ANTHROPIC_API_KEY="$(pass show audit-engine/api-key)" node apps/cli/src/index.ts run ...
#
ANTHROPIC_API_KEY=
